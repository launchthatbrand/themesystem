{
  "name": "@acme/theme-system",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./providers": {
      "import": "./src/providers/index.ts",
      "require": "./src/providers/index.ts"
    },
    "./components": {
      "import": "./src/components/index.ts",
      "require": "./src/components/index.ts"
    },
    "./theme": {
      "import": "./src/theme.ts",
      "require": "./src/theme.ts"
    },
    "./styles": {
      "import": "./src/styles/index.ts",
      "require": "./src/styles/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "rm -rf .turbo && rm -rf node_modules"
  },
  "peerDependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@acme/ui": "workspace:*",
    "next-themes": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.37",
    "eslint": "^8.53.0",
    "typescript": "^5.2.2"
  }
}
