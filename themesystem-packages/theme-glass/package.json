{
  "name": "@themesystem/glass",
  "version": "0.1.0",
  "type": "module",
  "description": "Glass theme for ThemeSystem - Clean, minimal interface with subtle transparency effects",
  "author": "ACME Corp",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/glass.css",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && npm run copy-files",
    "copy-files": "copyfiles -u 1 src/**/*.css dist/",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@themesystem/config": "workspace:*",
    "@themesystem/types": "workspace:*"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "copyfiles": "^2.4.1",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "react": "catalog:react19"
  }
}
