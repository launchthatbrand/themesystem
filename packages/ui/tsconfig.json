{
  "extends": "@acme/tsconfig/internal-package.json",
  "compilerOptions": {
    "lib": ["ES2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@acme/ui": ["src/index.ts"],
      "src/lib/utils": ["src/lib/utils.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
